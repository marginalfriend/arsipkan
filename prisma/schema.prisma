// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Developer {
  id        String    @id @default(uuid())
  folder_id String
  name      String
  Companies Company[]
}

model Company {
  id           String    @id @default(uuid())
  name         String
  folder_id    String
  developer_id String
  developer    Developer @relation(fields: [developer_id], references: [id])
  Project      Project[]
}

model WorkType {
  id   String @id @default(uuid())
  name String
}

model Project {
  id             String          @id @default(uuid())
  project_name   String
  value          Int
  date           DateTime
  folder_id      String
  Bill           Bill[]
  BudgetProposal BudgetProposal?
  ShopDrawing    ShopDrawing?
  company_id     String
  company        Company         @relation(fields: [company_id], references: [id])
  SPK            SPK?
}

model BudgetProposal {
  id              String   @id @default(uuid())
  project_id      String   @unique
  project         Project  @relation(fields: [project_id], references: [id])
  proposal_number String
  value           Int
  date            DateTime
  doc_id          String
}

model ShopDrawing {
  id         String  @id @default(uuid())
  project_id String  @unique
  project    Project @relation(fields: [project_id], references: [id])
  doc_id     String
}

model SPK {
  id         String   @id @default(uuid())
  project_id String   @unique
  project    Project  @relation(fields: [project_id], references: [id])
  spk_number String   @unique
  date       DateTime
  doc_id     String
}

model Bill {
  id               String           @id @default(uuid())
  bill_sequence    Int              @default(autoincrement())
  receipt_sequence Int              @default(autoincrement())
  date             DateTime         @default(now())
  amount           Int
  vat              Int
  project_id       String
  project          Project          @relation(fields: [project_id], references: [id])
  SignedInvoice    SignedInvoice[]
  SignedReceipt    SignedReceipt[]
  Receipt          Receipt[]
  Invoice          Invoice[]
  Minutes          Minutes[]
  ProgressVolume   ProgressVolume[]
}

// Kwitansi
model Receipt {
  id      String @id @default(uuid())
  doc_id  String
  bill_id String
  bill    Bill   @relation(fields: [bill_id], references: [id])
}

model Invoice {
  id      String @id @default(uuid())
  doc_id  String
  bill_id String
  bill    Bill   @relation(fields: [bill_id], references: [id])
}

model Minutes {
  id      String @id @default(uuid())
  doc_id  String
  bill_id String
  bill    Bill   @relation(fields: [bill_id], references: [id])
}

model ProgressVolume {
  id      String @id @default(uuid())
  doc_id  String
  bill_id String
  bill    Bill   @relation(fields: [bill_id], references: [id])
}

model SignedInvoice {
  id      String @id @default(uuid())
  doc_id  String
  bill_id String
  Bill    Bill   @relation(fields: [bill_id], references: [id])
}

model SignedReceipt {
  id      String @id @default(uuid())
  bill_id String
  Bill    Bill   @relation(fields: [bill_id], references: [id])
}
